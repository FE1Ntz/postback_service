APP_NAME=PostbackService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=postbacks
DB_USERNAME=postbacks
# Replace these local-development placeholders before starting.
DB_PASSWORD=change-me-local-db
DB_ROOT_PASSWORD=change-me-local-root

CACHE_STORE=redis
CACHE_PREFIX=postback_service_
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-redis
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Start with: docker compose --profile mock up --build -d
# Or replace with your actual partner HTTP(S) endpoint and omit --profile mock.
PARTNER_API_URL=http://partner-mock:8080/events
PARTNER_CONNECT_TIMEOUT=2
PARTNER_TIMEOUT=5
PARTNER_RETRY_DELAY_MS=100
# Optional: require this bearer token when reading GET /events.
INSPECTION_TOKEN=
